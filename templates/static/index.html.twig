{% extends "base.html.twig" %}

{% block title %}LEGO® Set & Piece Value Analytics{% endblock %}

{% block content %}
    <div class="container">
        <div class="card border-0 bg-dark text-white shadow rounded-3 overflow-hidden mb-4">
            <div class="card-body p-4 p-lg-4">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-lg-7">
                        <span class="badge text-bg-warning text-dark fw-semibold mb-2 px-3 py-1 rounded-pill">
                            LEGO® Inventory &amp; Price-per-Piece Analytics
                        </span>
                        <h1 class="display-6 fw-bold mb-3">Find the Best-Value LEGO Sets for Any Piece</h1>
                        <p class="lead text-white-50 mb-4 fs-6">
                            Filter official LEGO set inventories by part category and element color, then rank every matching set by unit price efficiency to discover the most cost-effective part packs.
                        </p>
                        <div class="d-grid gap-2 d-sm-flex">
                            <a class="btn btn-warning fw-semibold px-4 py-2" href="{{ path('filter_items') }}">
                                Explore &amp; Filter Sets
                            </a>
                            <a class="btn btn-outline-light px-4 py-2" href="{{ path('load_range') }}">
                                Import Set Range
                            </a>
                        </div>
                    </div>
                    <div class="col-12 col-lg-5">
                        <div class="card bg-black bg-opacity-50 border border-secondary border-opacity-50 text-white rounded-3">
                            <div class="card-body p-3 p-md-4">
                                <div class="text-uppercase small fw-bold text-warning mb-1">How Valuation Works</div>
                                <h2 class="h6 fw-bold mb-3">Targeted Price-per-Piece Ranking</h2>
                                <ul class="list-unstyled mb-0 d-grid gap-2 small">
                                    <li class="d-flex align-items-start gap-2">
                                        <span class="badge text-bg-warning bg-opacity-100 text-dark fw-bold rounded-pill">1</span>
                                        <div>
                                            <strong class="d-block text-white">Select Element Criteria</strong>
                                            <span class="text-white-50">Choose a LEGO color and part category (e.g., Bricks, Plates, Technic).</span>
                                        </div>
                                    </li>
                                    <li class="d-flex align-items-start gap-2">
                                        <span class="badge text-bg-warning bg-opacity-100 text-dark fw-bold rounded-pill">2</span>
                                        <div>
                                            <strong class="d-block text-white">Aggregate Matching Parts</strong>
                                            <span class="text-white-50">Sums matching piece counts in each set and divides retail price by count.</span>
                                        </div>
                                    </li>
                                    <li class="d-flex align-items-start gap-2">
                                        <span class="badge text-bg-warning bg-opacity-100 text-dark fw-bold rounded-pill">3</span>
                                        <div>
                                            <strong class="d-block text-white">Compare &amp; Inspect</strong>
                                            <span class="text-white-50">Sort by Set Price, Pieces, or Price/Piece and inspect on Rebrickable.</span>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle text-uppercase px-2 py-1 mb-3 align-self-start">
                            Part &amp; Color Filtering
                        </span>
                        <h3 class="h5 fw-bold">Granular Inventory Search</h3>
                        <p class="text-body-secondary small mb-3 flex-grow-1">
                            Narrow down thousands of sets to those containing specific part categories and official LEGO colors so you only pay for the elements your MOC or collection needs.
                        </p>
                        <div class="mt-auto">
                            <a href="{{ path('filter_items') }}" class="btn btn-sm btn-outline-primary fw-semibold">
                                Filter by Part &amp; Color →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle text-uppercase px-2 py-1 mb-3 align-self-start">
                            Unit Cost Efficiency
                        </span>
                        <h3 class="h5 fw-bold">Price-per-Piece Metrics</h3>
                        <p class="text-body-secondary small mb-3 flex-grow-1">
                            Instantly compare sets by total retail price, matching piece count, and unit cost per piece—sorted from highest value efficiency to lowest.
                        </p>
                        <div class="mt-auto">
                            <a href="{{ path('filter_items', {'sort': 'pricePerPiece', 'direction': 'asc'}) }}" class="btn btn-sm btn-outline-success fw-semibold">
                                View Value Rankings →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle text-uppercase px-2 py-1 mb-3 align-self-start">
                            Open Data &amp; Code
                        </span>
                        <h3 class="h5 fw-bold">Rebrickable &amp; GitHub</h3>
                        <p class="text-body-secondary small mb-3 flex-grow-1">
                            Set inventories and part taxonomies are sourced from <a href="https://rebrickable.com" class="link-primary text-decoration-none fw-semibold" target="_blank" rel="noopener">Rebrickable</a>. Piece Analyzer is open-source—contributions and bug reports are welcome.
                        </p>
                        <div class="mt-auto">
                            <a href="https://github.com/BernhardWebstudio/PieceAnalyzer" class="btn btn-sm btn-outline-dark fw-semibold" title="PieceAnalyzer on GitHub" target="_blank" rel="noopener">
                                View on GitHub →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}