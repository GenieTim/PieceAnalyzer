{% extends "base.html.twig" %}

{% block title %}{{ 'home.meta_title'|trans }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="card border-0 bg-dark text-white shadow rounded-3 overflow-hidden mb-4">
            <div class="card-body p-4 p-lg-4">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-lg-7">
                        <span class="badge text-bg-warning text-dark fw-semibold mb-2 px-3 py-1 rounded-pill">
                            {{ 'home.hero_badge'|trans }}
                        </span>
                        <h1 class="display-6 fw-bold mb-3">{{ 'home.hero_title'|trans }}</h1>
                        <p class="lead text-white-50 mb-4 fs-6">
                            {{ 'home.hero_desc'|trans }}
                        </p>
                        <div class="d-grid gap-2 d-sm-flex">
                            <a class="btn btn-warning fw-semibold px-4 py-2" href="{{ path('filter_items') }}">
                                {{ 'home.btn_explore'|trans }}
                            </a>
                            <a class="btn btn-outline-light px-4 py-2" href="{{ path('load_range') }}">
                                {{ 'home.btn_import'|trans }}
                            </a>
                        </div>
                    </div>
                    <div class="col-12 col-lg-5">
                        <div class="card bg-black bg-opacity-50 border border-secondary border-opacity-50 text-white rounded-3">
                            <div class="card-body p-3 p-md-4">
                                <div class="text-uppercase small fw-bold text-warning mb-1">{{ 'home.how_works_badge'|trans }}</div>
                                <h2 class="h6 fw-bold mb-3">{{ 'home.how_works_title'|trans }}</h2>
                                <ul class="list-unstyled mb-0 d-grid gap-2 small">
                                    <li class="d-flex align-items-start gap-2">
                                        <span class="badge text-bg-warning bg-opacity-100 text-dark fw-bold rounded-pill">1</span>
                                        <div>
                                            <strong class="d-block text-white">{{ 'home.step1_title'|trans }}</strong>
                                            <span class="text-white-50">{{ 'home.step1_desc'|trans }}</span>
                                        </div>
                                    </li>
                                    <li class="d-flex align-items-start gap-2">
                                        <span class="badge text-bg-warning bg-opacity-100 text-dark fw-bold rounded-pill">2</span>
                                        <div>
                                            <strong class="d-block text-white">{{ 'home.step2_title'|trans }}</strong>
                                            <span class="text-white-50">{{ 'home.step2_desc'|trans }}</span>
                                        </div>
                                    </li>
                                    <li class="d-flex align-items-start gap-2">
                                        <span class="badge text-bg-warning bg-opacity-100 text-dark fw-bold rounded-pill">3</span>
                                        <div>
                                            <strong class="d-block text-white">{{ 'home.step3_title'|trans }}</strong>
                                            <span class="text-white-50">{{ 'home.step3_desc'|trans }}</span>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle text-uppercase px-2 py-1 mb-3 align-self-start">
                            {{ 'home.card_filter_badge'|trans }}
                        </span>
                        <h3 class="h5 fw-bold">{{ 'home.card_filter_title'|trans }}</h3>
                        <p class="text-body-secondary small mb-3 flex-grow-1">
                            {{ 'home.card_filter_desc'|trans }}
                        </p>
                        <div class="mt-auto">
                            <a href="{{ path('filter_items') }}" class="btn btn-sm btn-outline-primary fw-semibold">
                                {{ 'home.card_filter_btn'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle text-uppercase px-2 py-1 mb-3 align-self-start">
                            {{ 'home.card_efficiency_badge'|trans }}
                        </span>
                        <h3 class="h5 fw-bold">{{ 'home.card_efficiency_title'|trans }}</h3>
                        <p class="text-body-secondary small mb-3 flex-grow-1">
                            {{ 'home.card_efficiency_desc'|trans }}
                        </p>
                        <div class="mt-auto">
                            <a href="{{ path('filter_items', {'sort': 'pricePerPiece', 'direction': 'asc'}) }}" class="btn btn-sm btn-outline-success fw-semibold">
                                {{ 'home.card_efficiency_btn'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle text-uppercase px-2 py-1 mb-3 align-self-start">
                            {{ 'home.card_source_badge'|trans }}
                        </span>
                        <h3 class="h5 fw-bold">{{ 'home.card_source_title'|trans }}</h3>
                        <p class="text-body-secondary small mb-3 flex-grow-1">
                            {{ 'home.card_source_desc'|trans({'%rebrickable%': '<a href="https://rebrickable.com" class="link-primary text-decoration-none fw-semibold" target="_blank" rel="noopener">Rebrickable</a>'})|raw }}
                        </p>
                        <div class="mt-auto">
                            <a href="https://github.com/BernhardWebstudio/PieceAnalyzer" class="btn btn-sm btn-outline-dark fw-semibold" title="PieceAnalyzer on GitHub" target="_blank" rel="noopener">
                                {{ 'home.card_source_btn'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}