{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.sign_in_title'|trans }} — Piece Analyzer{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="fs-1">🧱</span>
                        <h1 class="h3 fw-bold mt-2 mb-1">{{ 'auth.sign_in_title'|trans }}</h1>
                        <p class="text-body-secondary small mb-0">
                            {{ 'auth.sign_in_desc'|trans }}
                        </p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger py-2 px-3 small mb-3">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label small fw-semibold">{{ 'auth.email'|trans }}</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label for="inputPassword" class="form-label small fw-semibold">{{ 'auth.password'|trans }}</label>
                            <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="d-grid mt-4 mb-3">
                            <button class="btn btn-primary" type="submit">
                                {{ 'auth.sign_in_title'|trans }}
                            </button>
                        </div>

                        <div class="d-flex justify-content-between align-items-center small text-body-secondary mt-3">
                            <span>{{ 'auth.dont_have_account'|trans }} <a href="{{ path('app_register') }}" class="fw-semibold text-decoration-none">{{ 'menu.register'|trans }}</a></span>
                            <a href="{{ path('app_resend_verification') }}" class="text-body-secondary text-decoration-none">{{ 'auth.resend_verification'|trans }}</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
