{% extends 'base.html.twig' %}

{% block title %}{{ set.no }} {{ set.name }} — Piece Analyzer{% endblock %}

{% block content %}
<div class="container py-4">
    <!-- Breadcrumb & Back Link -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="{{ path('index') }}" class="text-decoration-none">Startseite</a></li>
            <li class="breadcrumb-item"><a href="{{ path('filter_items') }}" class="text-decoration-none">Sets entdecken</a></li>
            <li class="breadcrumb-item active font-monospace" aria-current="page">{{ set.no }}</li>
        </ol>
    </nav>

    <!-- Set Hero Overview Card -->
    <div class="card shadow-sm border-0 mb-4 overflow-hidden">
        <div class="card-body p-3 p-md-4">
            <div class="row g-4 align-items-center">
                <!-- Set Image -->
                <div class="col-12 col-md-5 col-lg-4 text-center">
                    <div class="bg-body-subtle p-3 rounded-3 d-flex align-items-center justify-content-center" style="min-height: 260px;">
                        {% set primaryImg = set.imageUrl ? set.imageUrl : ('https://images.brickset.com/sets/images/' ~ set.no ~ '.jpg') %}
                        <img src="{{ primaryImg }}"
                             alt="{{ set.name }}"
                             class="img-fluid rounded"
                             style="max-height: 280px; object-fit: contain;"
                             loading="lazy"
                             onerror="if (!this.dataset.fb1) { this.dataset.fb1 = 1; this.src='https://cdn.rebrickable.com/media/sets/' + encodeURIComponent('{{ set.no }}') + '.jpg'; } else if (!this.dataset.fb2) { this.dataset.fb2 = 1; this.src='https://img.bricklink.com/ItemImage/SN/0/' + encodeURIComponent('{{ set.no }}') + '.png'; } else { this.onerror=null; this.style.opacity='0.4'; }">
                    </div>
                </div>

                <!-- Set Details -->
                <div class="col-12 col-md-7 col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge text-bg-dark font-monospace fs-6 px-3 py-2">{{ set.no }}</span>
                        {% if set.year %}
                            <span class="badge bg-light text-dark border fs-6 px-2 py-1">{{ set.year|date('Y') }}</span>
                        {% endif %}
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-2 py-1">
                            {{ set.pieceCount|number_format }} Teile
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary border fs-6 px-2 py-1">
                            {{ pieces|length }} Teilearten
                        </span>
                    </div>

                    <h1 class="h3 fw-bold mb-3 text-body-emphasis">{{ set.name }}</h1>

                    <!-- Current Price Highlight -->
                    <div class="p-3 bg-body-tertiary rounded-3 mb-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <span class="text-secondary small d-block">Bester ermittelter Preis</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="fs-4 fw-bold font-monospace text-primary">
                                    {{ bestPrice ? bestPrice.formattedPrice : '—' }}
                                </span>
                                {% if bestPrice and bestPrice.currency != currentCurrency %}
                                    <span class="text-secondary font-monospace small">
                                        (~{{ currentCurrency }} {{ convert_price(bestPrice.decimalPrice, bestPrice.currency, currentCurrency)|number_format(2) }})
                                    </span>
                                {% endif %}
                                {% if bestPrice %}
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle ms-1">
                                        {{ bestPrice.retailer.label }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        {% if bestPrice and set.pieceCount > 0 %}
                            {% set unitPrice = convert_price(bestPrice.decimalPrice, bestPrice.currency, currentCurrency) / set.pieceCount %}
                            <div class="text-md-end">
                                <span class="text-secondary small d-block">Preis pro Teil</span>
                                <span class="fs-5 fw-bold font-monospace text-body-secondary">
                                    {{ currentCurrency }} {{ unitPrice|number_format(3) }}
                                </span>
                                <span class="text-secondary small font-monospace d-block">
                                    ({{ (unitPrice * 100)|number_format(1) }} {{ minor_unit(currentCurrency) }})
                                </span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- External Source Links -->
                    <div class="d-flex flex-wrap gap-2">
                        <a href="https://www.lego.com/search?q={{ set.no|split('-')[0] }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                            LEGO.com ↗
                        </a>
                        <a href="https://www.bricklink.com/v2/catalog/catalogitem.page?S={{ set.no }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                            BrickLink ↗
                        </a>
                        <a href="https://brickset.com/sets/{{ set.no }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                            Brickset ↗
                        </a>
                        <a href="https://rebrickable.com/sets/{{ set.no }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                            Rebrickable ↗
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Price History & Trends -->
    <div class="card shadow-sm border-0 mb-4" id="prices">
        <div class="card-header bg-transparent py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold">💰 Preishistorie & Marktwert</h5>
            <span class="text-secondary small">{{ prices|length }} Preisangaben</span>
        </div>
        <div class="card-body p-3 p-md-4">
            {% include 'list/_price_history_content.html.twig' %}
        </div>
    </div>

    <!-- Section: Piece Inventory List -->
    <div class="card shadow-sm border-0" id="pieces">
        <div class="card-header bg-transparent py-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h5 class="mb-0 fw-bold">🧩 Enthaltene Teile (Teileliste)</h5>
                <span class="text-secondary small">{{ pieces|length }} Teilearten · {{ set.pieceCount|number_format }} Teile gesamt</span>
            </div>
            <div class="text-secondary small">
                Klicke auf ein Teil, um alle Sets mit diesem Teil anzuzeigen.
            </div>
        </div>
        <div class="card-body p-0">
            {% if pieces is empty %}
                <div class="text-center py-5 text-secondary">
                    Keine Teile-Informationen für dieses Set in der Datenbank vorhanden.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th class="ps-3 py-2" style="width: 70px;">Bild</th>
                                <th class="py-2" style="width: 130px;">Teil-Nr.</th>
                                <th class="py-2">Bezeichnung</th>
                                <th class="py-2" style="width: 180px;">Farbe</th>
                                <th class="py-2 text-end" style="width: 90px;">Menge</th>
                                <th class="py-2 text-end pe-3" style="width: 220px;">Aktion</th>
                            </tr>
                        </thead>
                        <tbody class="small font-monospace">
                            {% for piece in pieces %}
                                {% set colorInfo = colorMap[piece.color] ?? null %}
                                {% set colorHex = colorInfo ? colorInfo.rgb : '888888' %}
                                {% set colorName = colorInfo ? colorInfo.name : ('Farbe #' ~ piece.color) %}
                                <tr>
                                    <!-- Part Image -->
                                    <td class="ps-3 py-2">
                                        <div class="position-relative d-flex align-items-center justify-content-center bg-light border rounded" style="width: 48px; height: 48px;">
                                            <img src="https://cdn.rebrickable.com/media/parts/ldraw/{{ piece.color }}/{{ piece.no }}.png"
                                                 alt="{{ piece.name }}"
                                                 class="img-fluid"
                                                 style="max-width: 44px; max-height: 44px; object-fit: contain;"
                                                 loading="lazy"
                                                 onerror="if (!this.dataset.fb) { this.dataset.fb = 1; this.src='https://img.bricklink.com/ItemImage/PN/' + {{ piece.color }} + '/' + encodeURIComponent('{{ piece.no }}') + '.png'; } else { this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='block'; }">
                                            <span class="d-none text-secondary" style="font-size: 0.7rem;">🧩</span>
                                        </div>
                                    </td>

                                    <!-- Part Number -->
                                    <td class="py-2">
                                        <a href="{{ path('filter_items', {'part': piece.no}) }}" class="fw-semibold text-decoration-none link-primary">
                                            {{ piece.no }}
                                        </a>
                                    </td>

                                    <!-- Part Name -->
                                    <td class="py-2 font-sans">
                                        <span class="fw-medium text-body-emphasis">{{ piece.name }}</span>
                                    </td>

                                    <!-- Part Color -->
                                    <td class="py-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="d-inline-block rounded-circle border shadow-xs flex-shrink-0"
                                                  style="width: 14px; height: 14px; background-color: #{{ colorHex }};"
                                                  title="#{{ colorHex }}"></span>
                                            <span class="text-truncate" style="max-width: 140px;" title="{{ colorName }}">
                                                {{ colorName }}
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Quantity -->
                                    <td class="py-2 text-end">
                                        <span class="badge text-bg-secondary px-2 py-1 fs-6 font-monospace">
                                            {{ piece.count }}x
                                        </span>
                                    </td>

                                    <!-- Filter Button -->
                                    <td class="py-2 text-end pe-3">
                                        <a href="{{ path('filter_items', {'part': piece.no, 'color': piece.color}) }}"
                                           class="btn btn-sm btn-outline-primary text-nowrap"
                                           title="Alle Sets im Katalog anzeigen, die dieses Teil in dieser Farbe enthalten">
                                            Sets mit diesem Teil ↗
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
