<div class="price-history-container">
    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge text-bg-dark font-monospace fs-6 px-2 py-1">{{ set.no }}</span>
                <h5 class="mb-0 fw-bold">{{ set.name }}</h5>
            </div>
            <div class="text-secondary small mt-1">
                {% if set.year %}<span>{{ set.year|date('Y') }}</span> · {% endif %}
                <span>{{ 'set.pieces_count'|trans({'%count%': set.pieceCount|number_format}) }}</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('set_detail', {'id': set.id}) }}" class="btn btn-sm btn-primary">
                {{ 'set.view_set_page'|trans }} →
            </a>
            {% set externalUrl = set.source == 'rebrickable' ? ('https://rebrickable.com/sets/' ~ set.no) : ('https://www.bricklink.com/v2/catalog/catalogitem.page?S=' ~ set.no) %}
            <a href="{{ externalUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                {{ 'set.view_on_rebrickable'|trans }} ↗
            </a>

        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
            <div class="p-2 border rounded bg-body-subtle text-center h-100">
                <span class="text-secondary small d-block">{{ 'set.best_price'|trans }}</span>
                <span class="fw-bold fs-5 text-dark font-monospace">
                    {{ bestPrice ? bestPrice.formattedPrice : '—' }}
                </span>
                {% if bestPrice and bestPrice.currency != currentCurrency %}
                    <span class="d-block text-secondary small font-monospace mt-1">
                        ~{{ currentCurrency }} {{ convert_price(bestPrice.decimalPrice, bestPrice.currency, currentCurrency)|number_format(2) }}
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-2 border border-success-subtle rounded bg-success-subtle text-center h-100">
                <span class="text-success-emphasis small d-block">{{ 'set.lowest_price'|trans }}</span>
                <span class="fw-bold fs-5 text-success-emphasis font-monospace">
                    {{ lowestPrice ? lowestPrice.formattedPrice : '—' }}
                </span>
                {% if lowestPrice and lowestPrice.currency != currentCurrency %}
                    <span class="d-block text-success-emphasis small font-monospace mt-1">
                        ~{{ currentCurrency }} {{ convert_price(lowestPrice.decimalPrice, lowestPrice.currency, currentCurrency)|number_format(2) }}
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-2 border rounded bg-body-subtle text-center h-100">
                <span class="text-secondary small d-block">{{ 'set.highest_price'|trans }}</span>
                <span class="fw-bold fs-5 text-secondary font-monospace">
                    {{ highestPrice ? highestPrice.formattedPrice : '—' }}
                </span>
                {% if highestPrice and highestPrice.currency != currentCurrency %}
                    <span class="d-block text-secondary small font-monospace mt-1">
                        ~{{ currentCurrency }} {{ convert_price(highestPrice.decimalPrice, highestPrice.currency, currentCurrency)|number_format(2) }}
                    </span>
                {% endif %}
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-2 border rounded bg-body-subtle text-center h-100">
                <span class="text-secondary small d-block">{{ 'set.historical_savings'|trans }}</span>
                {% if savingsDelta %}
                    <span class="fw-bold fs-5 text-success font-monospace">
                        -{{ savingsDelta.savingsPercent }}%
                    </span>
                    <span class="d-block text-secondary small font-monospace mt-1">
                        ({{ currentCurrency }} {{ savingsDelta.savingsAmount|number_format(2) }})
                    </span>
                {% else %}
                    <span class="text-secondary font-monospace small">{{ 'set.no_delta'|trans }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Trend Chart Visualization (SVG) -->
    {% if prices|length > 1 %}
        {% set chronologicalPrices = set.pricesSortedByDate('ASC') %}
        
        {# Calculate min and max normalized to currentCurrency to prevent cross-currency distortion #}
        {% set minNorm = null %}
        {% set maxNorm = null %}
        {% set firstDate = null %}
        {% set lastDate = null %}
        {% set normList = [] %}
        
        {% for p in chronologicalPrices %}
            {% set cVal = convert_price(p.decimalPrice, p.currency, currentCurrency) %}
            {% if minNorm is null or cVal < minNorm %}
                {% set minNorm = cVal %}
            {% endif %}
            {% if maxNorm is null or cVal > maxNorm %}
                {% set maxNorm = cVal %}
            {% endif %}
            {% if firstDate is null %}
                {% set firstDate = p.recordedAt|date('Y-m-d') %}
            {% endif %}
            {% set lastDate = p.recordedAt|date('Y-m-d') %}
            {% set normList = normList|merge([{
                'p': p,
                'val': cVal
            }]) %}
        {% endfor %}

        {% if maxNorm == minNorm %}
            {% set minNorm = (minNorm * 0.9)|round(2) %}
            {% set maxNorm = (maxNorm * 1.1)|round(2) %}
        {% endif %}
        {% set pRange = (maxNorm - minNorm) > 0 ? (maxNorm - minNorm) : 1 %}
        {% set count = normList|length %}
        {% set isSameDay = firstDate == lastDate %}

        <div class="card mb-4 border shadow-sm">
            <div class="card-header bg-transparent py-2 d-flex justify-content-between align-items-center">
                <span class="fw-semibold small">📈 {{ 'set.price_trend'|trans }} ({{ currentCurrency }})</span>
                <span class="text-secondary small">{{ 'set.data_points'|trans({'%count%': count}) }}</span>
            </div>
            <div class="card-body p-2 p-sm-3">
                <div class="table-responsive">
                    <svg viewBox="0 0 520 140" class="w-100" style="max-height: 180px; overflow: visible;" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="priceGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#0d6efd" stop-opacity="0.25" />
                                <stop offset="100%" stop-color="#0d6efd" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>

                        <!-- Horizontal Grid Lines -->
                        <line x1="40" y1="20" x2="500" y2="20" stroke="#dee2e6" stroke-dasharray="3,3" />
                        <text x="35" y="24" text-anchor="end" font-size="10" fill="#6c757d" font-family="monospace">{{ currentCurrency }} {{ maxNorm|number_format(0) }}</text>

                        <line x1="40" y1="110" x2="500" y2="110" stroke="#dee2e6" stroke-dasharray="3,3" />
                        <text x="35" y="114" text-anchor="end" font-size="10" fill="#6c757d" font-family="monospace">{{ currentCurrency }} {{ minNorm|number_format(0) }}</text>

                        <!-- Plot Points -->
                        {% set points = '' %}
                        {% set areaPoints = '40,110 ' %}
                        {% for i, item in normList %}
                            {% set x = count > 1 ? (40 + (i / (count - 1)) * 460) : 270 %}
                            {% set normY = (item.val - minNorm) / pRange %}
                            {% set y = 110 - (normY * 90) %}
                            {% set points = points ~ x ~ ',' ~ y ~ ' ' %}
                            {% set areaPoints = areaPoints ~ x ~ ',' ~ y ~ ' ' %}
                        {% endfor %}
                        {% set areaPoints = areaPoints ~ '500,110' %}

                        <!-- Gradient Fill under chart -->
                        <polygon points="{{ areaPoints }}" fill="url(#priceGradient)" />

                        <!-- Connecting Trend Line -->
                        <polyline fill="none" stroke="#0d6efd" stroke-width="2.5" points="{{ points }}" stroke-linejoin="round" stroke-linecap="round" />

                        <!-- Data Point Markers -->
                        {% for i, item in normList %}
                            {% set p = item.p %}
                            {% set x = count > 1 ? (40 + (i / (count - 1)) * 460) : 270 %}
                            {% set normY = (item.val - minNorm) / pRange %}
                            {% set y = 110 - (normY * 90) %}
                            {% set isLowest = lowestPrice and p.id == lowestPrice.id %}
                            <circle cx="{{ x }}" cy="{{ y }}" r="{{ isLowest ? 5 : 3.5 }}" fill="{{ isLowest ? '#198754' : '#0d6efd' }}" stroke="#ffffff" stroke-width="1.5">
                                <title>{{ p.retailer.label }}{% if p.conditionLabel %} ({{ p.conditionLabel }}){% endif %}: {{ currentCurrency }} {{ item.val|number_format(2) }}{% if p.currency != currentCurrency %} ({{ p.formattedPrice }}){% endif %} ({{ p.recordedAt|date('Y-m-d H:i') }})</title>
                            </circle>
                            <text x="{{ x }}" y="130" text-anchor="middle" font-size="9" fill="#888888" font-family="monospace">
                                {% if isSameDay %}
                                    {{ p.retailer.label|slice(0, 8) }}
                                {% else %}
                                    {{ p.recordedAt|date('M j') }}
                                {% endif %}
                            </text>
                        {% endfor %}
                    </svg>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Price Recordings Table -->
    <h6 class="fw-bold mb-2">{{ 'set.recorded_sources'|trans({'%count%': prices|length}) }}</h6>
    {% if prices is empty %}
        <div class="alert alert-light border text-center py-3 text-secondary">
            {{ 'set.no_prices_yet'|trans }}
        </div>
    {% else %}
        <div class="table-responsive border rounded">
            <table class="table table-sm table-hover mb-0 align-middle">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-3 py-2">{{ 'set.retailer'|trans }}</th>
                        <th class="py-2">{{ 'set.condition'|trans }}</th>
                        <th class="py-2 text-end">{{ 'set.original_price'|trans }}</th>
                        <th class="py-2 text-end">{{ 'table.price'|trans({'%currency%': currentCurrency}) }}</th>
                        <th class="py-2 text-center">{{ 'set.status'|trans }}</th>
                        <th class="py-2 d-none d-sm-table-cell">{{ 'set.provider'|trans }}</th>
                        <th class="py-2 text-end pe-3">{{ 'set.recorded'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="small font-monospace">
                    {% for p in prices %}
                        {% set normVal = convert_price(p.decimalPrice, p.currency, currentCurrency) %}
                        <tr>
                            <td class="ps-3">
                                <a href="{{ p.retailerUrl }}" target="_blank" rel="noopener noreferrer" class="fw-semibold text-decoration-none">
                                    {{ p.retailer.label }} ↗
                                </a>
                            </td>
                            <td>
                                {% if p.itemCondition == 'msrp' %}
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border">{{ 'set.condition_msrp'|trans }}</span>
                                {% elseif p.itemCondition == 'new' %}
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">{{ 'set.condition_new'|trans }}</span>
                                {% elseif p.itemCondition == 'used' %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">{{ 'set.condition_used'|trans }}</span>
                                {% else %}
                                    <span class="text-secondary">—</span>
                                {% endif %}
                            </td>
                            <td class="text-end text-body-secondary">
                                {{ p.formattedPrice }}
                            </td>
                            <td class="text-end fw-bold">
                                {{ currentCurrency }} {{ normVal|number_format(2) }}
                                {% if lowestPrice and p.id == lowestPrice.id %}
                                    <span class="badge text-bg-success ms-1" style="font-size: 0.65rem;">{{ 'set.lowest'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if p.status.value == 'verified' %}
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">{{ 'set.status_verified'|trans }}</span>
                                {% elseif p.status.value == 'unverified' %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">{{ 'set.status_unverified'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">{{ 'set.status_rejected'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="d-none d-sm-table-cell text-body-secondary">
                                {% if p.sourceUrl %}
                                    <a href="{{ p.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none link-secondary">
                                        {{ p.provider.label }} ↗
                                    </a>
                                {% else %}
                                    {{ p.provider.label }}
                                {% endif %}
                                {% if p.submittedBy %}
                                    <span class="badge bg-light text-secondary border ms-1">{{ 'set.by_user'|trans({'%user%': p.submittedBy.userIdentifier|split('@')[0]}) }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end pe-3 text-body-secondary">
                                {{ p.recordedAt|date('Y-m-d H:i') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
