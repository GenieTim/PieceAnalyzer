{% extends 'base.html.twig' %}

{% block title %}{{ set.no }} {{ set.name }} — Price History{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="mb-3">
                <a href="{{ path('filter_items') }}" class="text-decoration-none small link-secondary">
                    {{ 'set.back_to_explorer'|trans }}
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    {% include 'list/_price_history_content.html.twig' %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
