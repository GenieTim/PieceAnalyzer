{% extends 'base.html.twig' %}

{% block title %}Price Grabber Bookmarklet{% endblock %}

{% block content %}
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="fs-1">📌</span>
                            <div>
                                <h1 class="h3 fw-bold mb-1">Swiss &amp; EU Price Grabber Bookmarklet</h1>
                                <p class="text-body-secondary mb-0">
                                    Send live prices from <strong>Galaxus.ch</strong>, <strong>Brack.ch</strong>, <strong>Amazon.de</strong>, and <strong>Amazon.com</strong> directly into Piece Analyzer.
                                </p>
                            </div>
                        </div>

                        <div class="alert alert-info border-info-subtle bg-info-subtle d-flex align-items-start gap-2 mb-4" role="alert">
                            <span class="fs-5">💡</span>
                            <div class="small">
                                <strong>Why a bookmarklet?</strong> Anti-bot protection (Cloudflare, Turnstile, Datadome) blocks server-side scraping of retailers like Galaxus. Using this bookmarklet in your regular browser bypasses blocks seamlessly with your real residential IP.
                            </div>
                        </div>

                        <h2 class="h5 fw-bold mb-3">1. Install the Bookmarklet</h2>
                        <p class="text-body-secondary">
                            Drag the button below to your browser’s <strong>Bookmarks / Favorites Bar</strong>. It is pre-configured with your secure Contributor Token:
                        </p>

                        <div class="text-center py-3 bg-light rounded-3 border border-dashed mb-4">
                            <a class="btn btn-warning btn-lg fw-bold px-4 py-2 shadow-sm text-dark"
                               href="{{ bookmarkletHref }}"
                               title="Drag this button to your bookmarks bar"
                               onclick="alert('Drag this button directly to your browser\'s bookmarks bar!'); return false;">
                                🧱 Add to Piece Analyzer
                            </a>
                            <div class="small text-muted mt-2">
                                ↑ Drag this button to your browser toolbar
                            </div>
                        </div>

                        <div class="card bg-light-subtle border mb-4">
                            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div>
                                    <span class="small text-body-secondary d-block">Your Contributor API Token:</span>
                                    <code class="user-select-all font-monospace fw-semibold">{{ apiToken }}</code>
                                </div>
                                <form method="post" action="{{ path('bookmarklet_regenerate_token') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('regenerate_token') }}">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Regenerate your token? You will need to re-drag the bookmarklet to your toolbar.');">
                                        Regenerate Token
                                    </button>
                                </form>
                            </div>
                        </div>

                        <h2 class="h5 fw-bold mb-3">2. How to Use</h2>
                        <ol class="list-group list-group-numbered mb-4">
                            <li class="list-group-item border-0 px-0 py-2">
                                Open any LEGO set product page on 
                                <a href="https://www.galaxus.ch" target="_blank" rel="noopener">Galaxus.ch</a>, 
                                <a href="https://www.brack.ch" target="_blank" rel="noopener">Brack.ch</a>, 
                                <a href="https://www.amazon.de" target="_blank" rel="noopener">Amazon.de</a>, or 
                                <a href="https://www.amazon.com" target="_blank" rel="noopener">Amazon.com</a>.
                            </li>
                            <li class="list-group-item border-0 px-0 py-2">
                                Click the <strong>“Add to Piece Analyzer”</strong> bookmarklet in your toolbar.
                            </li>
                            <li class="list-group-item border-0 px-0 py-2">
                                Verify the detected set number and price in the prompt, then click <strong>OK</strong>.
                            </li>
                            <li class="list-group-item border-0 px-0 py-2">
                                The price, currency, and product link are instantly saved and recorded in Piece Analyzer!
                            </li>
                        </ol>

                        <h2 class="h5 fw-bold mb-3">Supported Retailers</h2>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇨🇭 Galaxus.ch / Digitec.ch</strong>
                                    <div class="small text-muted">Supports CHF pricing &amp; direct set matching</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇨🇭 Brack.ch</strong>
                                    <div class="small text-muted">Supports CHF pricing &amp; product detail parsing</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇩🇪 Amazon.de</strong>
                                    <div class="small text-muted">Supports EUR pricing</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇺🇸 Amazon.com</strong>
                                    <div class="small text-muted">Supports USD pricing</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
