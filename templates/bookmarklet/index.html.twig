{% extends 'base.html.twig' %}

{% block title %}{{ 'bookmarklet.meta_title'|trans }} — Piece Analyzer{% endblock %}

{% block content %}
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="fs-1">📌</span>
                            <div>
                                <h1 class="h3 fw-bold mb-1">{{ 'bookmarklet.title'|trans }}</h1>
                                <p class="text-body-secondary mb-0">
                                    {{ 'bookmarklet.subtitle'|trans({'%stores%': '<strong>Galaxus.ch</strong>, <strong>Brack.ch</strong>, <strong>Amazon.de</strong>, and <strong>Amazon.com</strong>'})|raw }}
                                </p>
                            </div>
                        </div>

                        <div class="alert alert-info border-info-subtle bg-info-subtle d-flex align-items-start gap-2 mb-4" role="alert">
                            <span class="fs-5">💡</span>
                            <div class="small">
                                <strong>{{ 'bookmarklet.why_title'|trans }}</strong> {{ 'bookmarklet.why_desc'|trans }}
                            </div>
                        </div>

                        <h2 class="h5 fw-bold mb-3">{{ 'bookmarklet.step1_title'|trans }}</h2>
                        <p class="text-body-secondary">
                            {{ 'bookmarklet.step1_desc'|trans({'%bar%': '<strong>' ~ ('bookmarklet.favorites_bar'|trans) ~ '</strong>'})|raw }}
                        </p>

                        <div class="text-center py-3 bg-light rounded-3 border border-dashed mb-4">
                            <a class="btn btn-warning btn-lg fw-bold px-4 py-2 shadow-sm text-dark"
                               href="{{ bookmarkletHref }}"
                               title="{{ 'bookmarklet.drag_title'|trans }}"
                               onclick="alert('{{ 'bookmarklet.drag_alert'|trans|e('js') }}'); return false;">
                                {{ 'bookmarklet.button_text'|trans }}
                            </a>
                            <div class="small text-muted mt-2">
                                {{ 'bookmarklet.drag_hint'|trans }}
                            </div>
                        </div>

                        <div class="card bg-light-subtle border mb-4">
                            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div>
                                    <span class="small text-body-secondary d-block">{{ 'bookmarklet.token_label'|trans }}</span>
                                    <code class="user-select-all font-monospace fw-semibold">{{ apiToken }}</code>
                                </div>
                                <form method="post" action="{{ path('bookmarklet_regenerate_token') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('regenerate_token') }}">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="return confirm('{{ 'bookmarklet.regenerate_confirm'|trans|e('js') }}');">
                                        {{ 'bookmarklet.regenerate_token'|trans }}
                                    </button>
                                </form>
                            </div>
                        </div>

                        <h2 class="h5 fw-bold mb-3">{{ 'bookmarklet.step2_title'|trans }}</h2>
                        <ol class="list-group list-group-numbered mb-4">
                            <li class="list-group-item border-0 px-0 py-2">
                                {{ 'bookmarklet.step2_item1'|trans({'%links%': '<a href="https://www.galaxus.ch" target="_blank" rel="noopener">Galaxus.ch</a>, <a href="https://www.brack.ch" target="_blank" rel="noopener">Brack.ch</a>, <a href="https://www.amazon.de" target="_blank" rel="noopener">Amazon.de</a>, or <a href="https://www.amazon.com" target="_blank" rel="noopener">Amazon.com</a>'})|raw }}
                            </li>
                            <li class="list-group-item border-0 px-0 py-2">
                                {{ 'bookmarklet.step2_item2'|trans({'%btn%': '<strong>' ~ ('bookmarklet.button_text'|trans) ~ '</strong>'})|raw }}
                            </li>
                            <li class="list-group-item border-0 px-0 py-2">
                                {{ 'bookmarklet.step2_item3'|trans }}
                            </li>
                            <li class="list-group-item border-0 px-0 py-2">
                                {{ 'bookmarklet.step2_item4'|trans }}
                            </li>
                        </ol>

                        <h2 class="h5 fw-bold mb-3">{{ 'bookmarklet.retailers_title'|trans }}</h2>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇨🇭 Toppreise.ch</strong>
                                    <div class="small text-muted">{{ 'bookmarklet.retailer_toppreise_desc'|trans }}</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇨🇭 Galaxus.ch / Digitec.ch</strong>
                                    <div class="small text-muted">{{ 'bookmarklet.retailer_galaxus_desc'|trans }}</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇨🇭 Brack.ch</strong>
                                    <div class="small text-muted">{{ 'bookmarklet.retailer_brack_desc'|trans }}</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🧱 LEGO.com (Official Store)</strong>
                                    <div class="small text-muted">{{ 'bookmarklet.retailer_lego_desc'|trans }}</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇩🇪 Amazon.de</strong>
                                    <div class="small text-muted">{{ 'bookmarklet.retailer_amazonde_desc'|trans }}</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 border rounded-2 bg-light-subtle">
                                    <strong>🇺🇸 Amazon.com</strong>
                                    <div class="small text-muted">{{ 'bookmarklet.retailer_amazoncom_desc'|trans }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
