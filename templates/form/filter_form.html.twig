<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
        {{ form_start(form) }}
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                {{ form_row(form.part, {'row_attr': {'class': 'mb-0'}, 'label_attr': {'class': 'form-label fw-semibold small text-uppercase text-body-secondary'}}) }}
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                {{ form_row(form.color, {'row_attr': {'class': 'mb-0'}, 'label_attr': {'class': 'form-label fw-semibold small text-uppercase text-body-secondary'}}) }}
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                {{ form_row(form.category, {'row_attr': {'class': 'mb-0'}, 'label_attr': {'class': 'form-label fw-semibold small text-uppercase text-body-secondary'}}) }}
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                {{ form_widget(form.search, {'attr': {'class': 'btn btn-primary flex-grow-1 fw-semibold'}}) }}
                <a href="{{ path('filter_items') }}" class="btn btn-outline-secondary" title="Reset all filters">Reset</a>
            </div>
        </div>
        <div class="form-text small text-body-secondary mt-2">
            💡 Enter a specific part number (e.g. <code>3001</code>) or name to find the best-value sets containing that part, ranked by lowest cost per piece.
        </div>
        {{ form_end(form) }}
    </div>
</div>