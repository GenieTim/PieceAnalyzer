<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        {{ form_start(form) }}
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-2">
                {{ form_row(form.set, {
                    'label': form.set.vars.label|trans,
                    'row_attr': {'class': 'mb-0'},
                    'label_attr': {'class': 'form-label fw-medium small text-secondary mb-1'},
                    'attr': {'placeholder': 'filter.set_placeholder'|trans}
                }) }}
            </div>
            <div class="col-12 col-md-3">
                {{ form_row(form.part, {
                    'label': form.part.vars.label|trans,
                    'row_attr': {'class': 'mb-0'},
                    'label_attr': {'class': 'form-label fw-medium small text-secondary mb-1'},
                    'attr': {'placeholder': 'filter.part_placeholder'|trans}
                }) }}
            </div>
            <div class="col-6 col-md-2">
                {{ form_row(form.minYear, {
                    'label': form.minYear.vars.label|trans,
                    'row_attr': {'class': 'mb-0'},
                    'label_attr': {'class': 'form-label fw-medium small text-secondary mb-1'},
                    'attr': {'placeholder': 'filter.year_placeholder'|trans}
                }) }}
            </div>
            <div class="col-6 col-md-2">
                {{ form_row(form.color, {
                    'label': form.color.vars.label|trans,
                    'row_attr': {'class': 'mb-0'},
                    'label_attr': {'class': 'form-label fw-medium small text-secondary mb-1'}
                }) }}
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                {{ form_row(form.category, {
                    'label': form.category.vars.label|trans,
                    'row_attr': {'class': 'mb-0'},
                    'label_attr': {'class': 'form-label fw-medium small text-secondary mb-1'}
                }) }}
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-2 border-top">
            <div class="form-check form-switch small mb-0">
                {{ form_widget(form.excludeUsed, {
                    'attr': {'class': 'form-check-input', 'role': 'switch'}
                }) }}
                {{ form_label(form.excludeUsed, form.excludeUsed.vars.label|trans, {
                    'label_attr': {'class': 'form-check-label text-secondary'}
                }) }}
            </div>
            <div class="d-flex gap-2 ms-auto">
                {{ form_widget(form.search, {
                    'label': form.search.vars.label|trans,
                    'attr': {'class': 'btn btn-primary px-4 fw-medium'}
                }) }}
                <a href="{{ path('filter_items') }}" class="btn btn-outline-secondary" title="{{ 'filter.reset'|trans }}">{{ 'filter.reset'|trans }}</a>
            </div>
        </div>
        <div class="form-text small text-secondary mt-2">
            {{ 'filter.help_text'|trans }}
        </div>
        {{ form_end(form) }}
    </div>
</div>