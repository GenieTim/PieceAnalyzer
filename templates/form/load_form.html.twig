{% extends "base.html.twig" %}

{% block title %}{{ 'import.meta_title'|trans }} — Piece Analyzer{% endblock %}

{% block content %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3 px-4">
                        <h1 class="h4 fw-bold mb-1">{{ 'import.title'|trans }}</h1>
                        <p class="text-body-secondary small mb-0">
                            {{ 'import.desc'|trans }}
                        </p>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-light border small text-body-secondary mb-4" role="note">
                            <strong class="text-body-emphasis">{{ 'import.how_works_title'|trans }}</strong>
                            {{ 'import.how_works_desc'|trans({'%start%': '<code>10000</code>', '%end%': '<code>10050</code>'})|raw }}
                        </div>
                        {{ form_start(form) }}
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                {{ form_row(form.from, {
                                    'label': 'import.start_set_number'|trans,
                                    'help': 'import.start_set_help'|trans,
                                    'row_attr': {'class': 'mb-0'},
                                    'label_attr': {'class': 'form-label fw-semibold'}
                                }) }}
                            </div>
                            <div class="col-12 col-sm-6">
                                {{ form_row(form.to, {
                                    'label': 'import.end_set_number'|trans,
                                    'help': 'import.end_set_help'|trans,
                                    'row_attr': {'class': 'mb-0'},
                                    'label_attr': {'class': 'form-label fw-semibold'}
                                }) }}
                            </div>
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            {{ form_widget(form.save, {'label': 'import.submit'|trans}) }}
                            <a href="{{ path('filter_items') }}" class="btn btn-outline-secondary">{{ 'import.back_to_explorer'|trans }}</a>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}