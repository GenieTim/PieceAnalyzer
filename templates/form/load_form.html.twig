{% extends "base.html.twig" %}

{% block title %}Import Set Range{% endblock %}

{% block content %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3 px-4">
                        <h1 class="h4 fw-bold mb-1">Import LEGO® Sets by Number Range</h1>
                        <p class="text-body-secondary small mb-0">
                            Synchronize set metadata and piece inventories from Rebrickable &amp; BrickLink across a sequential range of set numbers.
                        </p>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-light border small text-body-secondary mb-4" role="note">
                            <strong class="text-body-emphasis">How range import works:</strong>
                            Enter a starting and ending LEGO® set number (for example, <code>10000</code> to <code>10050</code>) to fetch matching set inventories and pricing into the analyzer database.
                        </div>
                        {{ form_start(form) }}
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                {{ form_row(form.from, {'row_attr': {'class': 'mb-0'}, 'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            </div>
                            <div class="col-12 col-sm-6">
                                {{ form_row(form.to, {'row_attr': {'class': 'mb-0'}, 'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            </div>
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            {{ form_widget(form.save) }}
                            <a href="{{ path('filter_items') }}" class="btn btn-outline-secondary">Back to Set Explorer</a>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}