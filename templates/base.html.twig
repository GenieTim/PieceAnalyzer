<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}Welcome{% endblock %} — Piece Analyzer</title>
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
			{{ encore_entry_link_tags('css/global') }}
		{% endblock %}
	</head>
	<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
		{% block body %}
			<header>
				<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-secondary-subtle">
					<div class="container">
						<a class="navbar-brand fw-bold d-inline-flex align-items-center gap-2" href="{{ path('index') }}">
							<span class="badge text-bg-warning text-dark px-2 py-1 rounded-1 fw-bolder" aria-hidden="true">🧱</span>
							<span>Piece Analyzer</span>
						</a>
						<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
							<span class="navbar-toggler-icon"></span>
						</button>

						<div class="collapse navbar-collapse" id="mainNavbar">
							{{ knp_menu_render('main', {'currentClass': 'active', 'template': 'other/b4_knp_menu.html.twig'}) }}
							<div class="navbar-nav ms-lg-3 d-flex align-items-center gap-1">
								<div class="nav-item dropdown">
									{% set currentCurr = app.session.get('pref_currency', 'CHF') %}
									<a class="nav-link dropdown-toggle text-light py-1 px-2 d-inline-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Preferred currency">
										<span class="font-monospace fw-semibold">{{ currentCurr }}</span>
									</a>
									<ul class="dropdown-menu dropdown-menu-end shadow-sm">
										<li><h6 class="dropdown-header">Preferred Currency</h6></li>
										<li><a class="dropdown-item small{% if currentCurr == 'CHF' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'CHF'}) }}">CHF (Swiss Franc)</a></li>
										<li><a class="dropdown-item small{% if currentCurr == 'EUR' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'EUR'}) }}">EUR (€ Euro)</a></li>
										<li><a class="dropdown-item small{% if currentCurr == 'USD' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'USD'}) }}">USD ($ Dollar)</a></li>
										<li><a class="dropdown-item small{% if currentCurr == 'GBP' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'GBP'}) }}">GBP (£ British Pound)</a></li>
									</ul>
								</div>

								{% if app.user %}
									<div class="nav-item dropdown">
										<a class="nav-link dropdown-toggle small text-light text-decoration-none py-1 px-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
											👤 {{ app.user.userIdentifier }}
										</a>
										<ul class="dropdown-menu dropdown-menu-end shadow-sm">
											<li><a class="dropdown-item small" href="{{ path('app_profile') }}">⚙️ Profile & Preferences</a></li>
											<li><a class="dropdown-item small" href="{{ path('bookmarklet') }}">📌 Price Bookmarklet</a></li>
											{% if is_granted('ROLE_ADMIN') %}
												<li><hr class="dropdown-divider"></li>
												<li><h6 class="dropdown-header">Administration</h6></li>
												<li><a class="dropdown-item small" href="{{ path('admin_price_moderation') }}">🛡️ Price Moderation</a></li>
											{% endif %}
											<li><hr class="dropdown-divider"></li>
											<li><a class="dropdown-item small text-danger" href="{{ path('app_logout') }}">Sign Out</a></li>
										</ul>
									</div>
								{% else %}
									<a href="{{ path('app_login') }}" class="btn btn-sm btn-outline-light ms-1 px-3 py-1">Sign In</a>
								{% endif %}
							</div>
						</div>
					</div>
				</nav>
			</header>

			<main class="flex-grow-1 py-4">
				<div class="container">
					{% for type, messages in app.flashes %}
						{% set alertClass = type in ['alert', 'error', 'danger'] ? 'danger' : (type in ['success', 'warning', 'info'] ? type : 'info') %}
						{% for message in messages %}
							<div class="alert alert-{{ alertClass }} alert-dismissible fade show shadow-sm mb-4" role="alert">
								{{ message }}
								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
							</div>
						{% endfor %}
					{% endfor %}
				</div>
				{% block content %}{% endblock %}
			</main>

			<footer class="footer mt-auto py-4 bg-dark text-light border-top border-secondary-subtle">
				<div class="container">
					<div class="row align-items-center gy-2">
						<div class="col-12 col-md-4 text-center text-md-start">
							<span class="fw-semibold text-white">Piece Analyzer</span>
							<span class="text-secondary small d-block">Copyright © Tim Bernhard, {{ "now"|date("Y") }}. All rights reserved.</span>
						</div>
						<div class="col-12 col-md-8 text-center text-md-end">
							<p class="text-secondary small mb-0">
								This webservice is provided “AS IS” without warranty of any kind, express or implied.
								LEGO® is a trademark of the LEGO Group of companies, which does not sponsor, authorize, or endorse this service.
							</p>
						</div>
					</div>
				</div>
			</footer>
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</body>
</html>
