<!DOCTYPE html>
<html lang="{{ app.request ? app.request.locale : 'en' }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}{{ 'base.welcome'|trans }}{% endblock %} — Piece Analyzer</title>
		<link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
		<link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
		<link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
		<link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
			{{ encore_entry_link_tags('css/global') }}
		{% endblock %}
	</head>
	<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
		{% block body %}
			<header>
				<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-secondary-subtle">
					<div class="container">
						<a class="navbar-brand fw-bold d-inline-flex align-items-center gap-2" href="{{ path('index') }}">
							<img src="{{ asset('logo.svg') }}" alt="Piece Analyzer Logo" width="30" height="30" class="d-inline-block">
							<span>Piece Analyzer</span>
						</a>
						<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="{{ 'menu.toggle_navigation'|trans }}">
							<span class="navbar-toggler-icon"></span>
						</button>

						<div class="collapse navbar-collapse" id="mainNavbar">
							{{ knp_menu_render('main', {'currentClass': 'active', 'template': 'other/b4_knp_menu.html.twig'}) }}
							<div class="navbar-nav ms-lg-3 d-flex align-items-center gap-2">
								<div class="nav-item dropdown">
									{% set currentCurr = user_currency() %}
									<a class="nav-link dropdown-toggle text-light py-1 px-2 d-inline-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ 'menu.currency'|trans }}">
										<span class="font-monospace fw-semibold">{{ currentCurr }}</span>
									</a>
									<ul class="dropdown-menu dropdown-menu-end shadow-sm">
										<li><h6 class="dropdown-header">{{ 'menu.currency'|trans }}</h6></li>
										<li><a class="dropdown-item small{% if currentCurr == 'CHF' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'CHF'}) }}">CHF (Swiss Franc)</a></li>
										<li><a class="dropdown-item small{% if currentCurr == 'EUR' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'EUR'}) }}">EUR (€ Euro)</a></li>
										<li><a class="dropdown-item small{% if currentCurr == 'USD' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'USD'}) }}">USD ($ Dollar)</a></li>
										<li><a class="dropdown-item small{% if currentCurr == 'GBP' %} active{% endif %}" href="{{ path('set_currency_preference', {'currency': 'GBP'}) }}">GBP (£ British Pound)</a></li>
									</ul>
								</div>

								{% if app.user %}
									<div class="nav-item dropdown">
										<a class="nav-link dropdown-toggle small text-light text-decoration-none py-1 px-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
											👤 {{ app.user.displayName }}
										</a>
										<ul class="dropdown-menu dropdown-menu-end shadow-sm">
											<li><a class="dropdown-item small" href="{{ path('app_profile') }}">⚙️ {{ 'menu.profile'|trans }}</a></li>
											<li><a class="dropdown-item small" href="{{ path('bookmarklet') }}">📌 {{ 'menu.bookmarklet'|trans }}</a></li>
											{% if is_granted('ROLE_ADMIN') %}
												<li><hr class="dropdown-divider"></li>
												<li><h6 class="dropdown-header">{{ 'menu.administration'|trans }}</h6></li>
												<li><a class="dropdown-item small" href="{{ path('admin_price_moderation') }}">🛡️ {{ 'menu.price_moderation'|trans }}</a></li>
											{% endif %}
											<li><hr class="dropdown-divider"></li>
											<li><a class="dropdown-item small text-danger" href="{{ path('app_logout') }}">{{ 'menu.sign_out'|trans }}</a></li>
										</ul>
									</div>
								{% else %}
									<a href="{{ path('app_login') }}" class="btn btn-sm btn-outline-light ms-2 px-3 py-1">{{ 'menu.sign_in'|trans }}</a>
								{% endif %}
							</div>
						</div>
					</div>
				</nav>
			</header>

			<main class="flex-grow-1 py-4">
				<div class="container">
					{% for type, messages in app.flashes %}
						{% set alertClass = type in ['alert', 'error', 'danger'] ? 'danger' : (type in ['success', 'warning', 'info'] ? type : 'info') %}
						{% for message in messages %}
							<div class="alert alert-{{ alertClass }} alert-dismissible fade show shadow-sm mb-4" role="alert">
								{{ message|trans }}
								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
							</div>
						{% endfor %}
					{% endfor %}
				</div>
				{% block content %}{% endblock %}
			</main>

			<footer class="footer mt-auto py-4 bg-dark text-light border-top border-secondary-subtle">
				<div class="container">
					<div class="row align-items-center gy-2">
						<div class="col-12 col-md-4 text-center text-md-start">
							<span class="fw-semibold text-white">Piece Analyzer</span>
							<span class="text-secondary small d-block">{{ 'footer.copyright'|trans({'%year%': "now"|date("Y")}) }}</span>
							{% set currentLocale = app.request ? app.request.locale : 'en' %}
							{% set currentRoute = app.current_route|default('index') %}
							{% set routeParams = app.current_route_parameters|default({}) %}
							{% set queryParams = app.request ? app.request.query.all : {} %}
							<div class="d-inline-flex align-items-center gap-2 mt-2 small text-secondary">
								<span>🌐</span>
								<a href="{{ path(currentRoute, routeParams|merge(queryParams)|merge({'_locale': 'en'})) }}" class="link-secondary text-decoration-none{% if currentLocale == 'en' %} text-white fw-semibold{% endif %}">English</a>
								<span>·</span>
								<a href="{{ path(currentRoute, routeParams|merge(queryParams)|merge({'_locale': 'de'})) }}" class="link-secondary text-decoration-none{% if currentLocale == 'de' %} text-white fw-semibold{% endif %}">Deutsch</a>
								<span>·</span>
								<a href="{{ path(currentRoute, routeParams|merge(queryParams)|merge({'_locale': 'fr'})) }}" class="link-secondary text-decoration-none{% if currentLocale == 'fr' %} text-white fw-semibold{% endif %}">Français</a>
							</div>
						</div>
						<div class="col-12 col-md-8 text-center text-md-end">
							<p class="text-secondary small mb-0">
								{{ 'footer.disclaimer'|trans }}
							</p>
						</div>
					</div>
				</div>
			</footer>
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</body>
</html>
