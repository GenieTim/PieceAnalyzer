<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Your Email Address — Piece Analyzer</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #212529;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f8f9fa; padding: 40px 10px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width: 600px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); overflow: hidden; border: 1px solid #e9ecef;" cellspacing="0" cellpadding="0">
                    <!-- Header -->
                    <tr>
                        <td style="background-color: #dc3545; padding: 24px 32px; text-align: left;">
                            <h1 style="margin: 0; font-size: 22px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px;">
                                🧱 Piece Analyzer
                            </h1>
                        </td>
                    </tr>
                    <!-- Content -->
                    <tr>
                        <td style="padding: 32px;">
                            <h2 style="margin-top: 0; margin-bottom: 16px; font-size: 20px; font-weight: 600; color: #212529;">
                                Welcome to Piece Analyzer!
                            </h2>
                            <p style="margin-top: 0; margin-bottom: 20px; font-size: 15px; line-height: 1.6; color: #495057;">
                                Thank you for creating an account. Please confirm your email address to activate your account and start contributing prices and managing your preferences.
                            </p>
                            <table role="presentation" cellspacing="0" cellpadding="0" style="margin: 28px 0;">
                                <tr>
                                    <td align="center" style="border-radius: 6px; background-color: #0d6efd;">
                                        <a href="{{ verifyUrl }}" target="_blank" rel="noopener noreferrer" style="font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 6px; display: inline-block;">
                                            Confirm Email Address
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            <p style="margin-top: 0; margin-bottom: 12px; font-size: 14px; line-height: 1.5; color: #6c757d;">
                                This confirmation link will expire in <strong>24 hours</strong>.
                            </p>
                            <p style="margin-top: 0; margin-bottom: 24px; font-size: 13px; line-height: 1.5; color: #868e96;">
                                If you cannot click the button above, copy and paste this link into your browser:<br>
                                <a href="{{ verifyUrl }}" style="color: #0d6efd; word-break: break-all;">{{ verifyUrl }}</a>
                            </p>
                            <hr style="border: 0; border-top: 1px solid #e9ecef; margin: 24px 0;">
                            <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #adb5bd;">
                                If you did not create an account on Piece Analyzer, you can safely ignore this email.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
