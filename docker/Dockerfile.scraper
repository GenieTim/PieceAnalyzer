# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PORT=8000

# Install required system packages for headless browser engines
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies for Camoufox and Playwright
RUN pip install --no-cache-dir camoufox playwright requests && \
    camoufox fetch || true

# Copy scraper code and extractor engine
COPY assets/js/scraper ./assets/js/scraper
COPY scripts/camoufox_scraper.py ./scripts/camoufox_scraper.py
COPY scripts/scraper_service.py ./scripts/scraper_service.py

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/healthz || exit 1

CMD ["python3", "scripts/scraper_service.py"]
